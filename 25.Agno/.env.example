# Agno 框架環境變數配置範例
# 複製此文件為 .env 並填入你的實際值
# 使用方式：cp .env.example .env

# ==============================================================================
# OpenAI 配置（必需）
# ==============================================================================
# 獲取方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 組織 ID（可選）
# OPENAI_ORG_ID=your_org_id_here

# OpenAI 基礎 URL（可選，用於代理或自定義端點）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Anthropic Claude 配置（可選）
# ==============================================================================
# 獲取方式：https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# Google Gemini 配置（可選）
# ==============================================================================
# 獲取方式：https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# ==============================================================================
# Groq 配置（可選 - 高速推理）
# ==============================================================================
# 獲取方式：https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# 搜索工具 API Keys
# ==============================================================================
# Tavily 搜索（可選但推薦）
# 獲取方式：https://tavily.com
# TAVILY_API_KEY=your_tavily_api_key_here

# Exa 搜索（可選）
# 獲取方式：https://exa.ai
# EXA_API_KEY=your_exa_api_key_here

# SerpAPI（可選）
# 獲取方式：https://serpapi.com
# SERPAPI_API_KEY=your_serpapi_key_here

# ==============================================================================
# AgentOS 配置（生產環境部署）
# ==============================================================================
# AgentOS API Key
# 獲取方式：https://www.agno.com
# AGNO_API_KEY=your_agno_api_key_here

# AgentOS 工作空間
# AGNO_WORKSPACE=your_workspace_name

# ==============================================================================
# LangSmith 追蹤（可選 - 用於監控和調試）
# ==============================================================================
# 獲取方式：https://smith.langchain.com/
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=agno-demo

# ==============================================================================
# 數據庫配置
# ==============================================================================
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# SQLite（默認）
# DATABASE_URL=sqlite:///./agno.db

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/agno

# ==============================================================================
# Redis 配置（緩存）
# ==============================================================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your_redis_password

# ==============================================================================
# 向量數據庫配置
# ==============================================================================
# LanceDB（本地）
# LANCEDB_URI=/tmp/lancedb

# Qdrant（可選）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_key

# Pinecone（可選）
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_environment

# ==============================================================================
# 應用配置
# ==============================================================================
# 環境類型：development, staging, production
ENV=development

# 調試模式
DEBUG=true

# 日誌級別：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# API 服務配置
# ==============================================================================
# API 主機
# API_HOST=0.0.0.0

# API 端口
# API_PORT=8000

# API 密鑰（用於保護你的 API）
# API_SECRET_KEY=your_secret_key_here

# ==============================================================================
# 性能配置
# ==============================================================================
# 最大並發請求數
# MAX_CONCURRENT_REQUESTS=100

# 請求超時時間（秒）
# REQUEST_TIMEOUT=30

# 速率限制（每分鐘）
# RATE_LIMIT=100

# ==============================================================================
# 監控和追蹤
# ==============================================================================
# Sentry 錯誤追蹤（可選）
# SENTRY_DSN=your_sentry_dsn_here

# 啟用性能指標
# ENABLE_METRICS=true

# OpenTelemetry 端點（可選）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ==============================================================================
# 安全配置
# ==============================================================================
# JWT 密鑰（如果使用認證）
# JWT_SECRET_KEY=your_jwt_secret_key

# JWT 過期時間（秒）
# JWT_EXPIRATION=3600

# 允許的來源（CORS）
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==============================================================================
# Model Context Protocol (MCP) 配置
# ==============================================================================
# MCP 服務器端點
# MCP_SERVER_URL=http://localhost:8080

# MCP API Key
# MCP_API_KEY=your_mcp_api_key

# ==============================================================================
# 其他第三方服務
# ==============================================================================
# Slack 通知（可選）
# SLACK_WEBHOOK_URL=your_slack_webhook_url

# Email 配置（可選）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ==============================================================================
# 開發工具
# ==============================================================================
# 啟用熱重載
# RELOAD=true

# 啟用詳細日誌
# VERBOSE=true

# ==============================================================================
# 配置說明
# ==============================================================================
#
# 1. 必需配置：
#    - OPENAI_API_KEY：運行大多數範例必需
#
# 2. 推薦配置：
#    - TAVILY_API_KEY：用於高質量網頁搜索
#    - DATABASE_URL：如果使用持久化存儲
#
# 3. 可選配置：
#    - 其他 LLM 提供者（Anthropic, Google, Groq）
#    - 監控工具（Sentry, LangSmith）
#    - 緩存服務（Redis）
#
# 4. 安全提示：
#    - 永遠不要將 .env 文件提交到版本控制
#    - 使用強密碼和密鑰
#    - 定期輪換 API Keys
#    - 在生產環境使用環境變數而非 .env 文件
#
# 5. 獲取 API Keys：
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic: https://console.anthropic.com/
#    - Tavily: https://tavily.com
#    - Agno: https://www.agno.com
#
# ==============================================================================
