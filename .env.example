# LLM Agent Demo - 環境變數範例
# 複製此文件為 .env 並填入你的 API Keys
#
# ⚠️ 安全警告：
# - 永遠不要將真實的 API 密鑰提交到 Git
# - 不要在代碼中硬編碼 API 密鑰
# - 定期輪換你的 API 密鑰
# - 使用環境變數或 secrets manager 管理敏感信息

# ==================== LLM 服務提供商 ====================

# OpenAI API Key
# 獲取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# 獲取地址: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API Key
# 獲取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key
# 獲取地址: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (可選)
# 獲取地址: https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# ==================== 向量數據庫 ====================

# Pinecone
# 獲取地址: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# Qdrant (如果使用雲端版本)
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# Weaviate (如果使用雲端版本)
WEAVIATE_URL=your_weaviate_url_here
WEAVIATE_API_KEY=your_weaviate_api_key_here

# ==================== 搜索和數據源 ====================

# Serper API (Google 搜索)
# 獲取地址: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Tavily API (AI 搜索)
# 獲取地址: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ==================== CRM 和辦公工具 ====================

# Airtable
# 獲取地址: https://airtable.com/create/tokens
AIRTABLE_ACCESS_TOKEN=your_airtable_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=your_table_name_here

# HubSpot
# 獲取地址: https://app.hubspot.com/
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Google Sheets
SHEET_ID=your_google_sheet_id_here

# ==================== 其他服務 ====================

# RapidAPI (用於 LinkedIn 等服務)
# 獲取地址: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# LangSmith (LangChain 追蹤和監控)
# 獲取地址: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=your_project_name_here

# ==================== 配置選項 ====================

# 日誌級別 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 模型選擇
DEFAULT_LLM_MODEL=gpt-4
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ==================== 說明 ====================
# 1. 複製此文件: cp .env.example .env
# 2. 填入你的實際 API Keys
# 3. 不要將 .env 文件提交到 Git
# 4. 至少需要配置一個 LLM 提供商的 API Key
# 5. 向量數據庫可選，大部分範例使用本地 Chroma
