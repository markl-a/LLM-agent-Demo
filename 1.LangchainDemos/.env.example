# ===========================================
# LangChain Demos 環境變數配置範本
# ===========================================
# 使用方法：
# 1. 複製此文件並重命名為 .env
# 2. 填入你的實際 API Keys
# 3. 確保 .env 文件已加入 .gitignore
# ===========================================

# ==================== LLM 提供者 ====================

# OpenAI API Key (必需，用於大部分範例)
# 獲取方式: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (選用，用於 Claude 模型)
# 獲取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# HuggingFace Token (選用，用於開源模型)
# 獲取方式: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# Groq API Key (選用，用於高速推理)
# 獲取方式: https://console.groq.com/
GROQ_API_KEY=gsk_your-groq-api-key-here

# ==================== LangSmith 追蹤 ====================

# LangSmith API Key (強烈建議，用於追蹤和除錯)
# 獲取方式: https://smith.langchain.com/
LANGCHAIN_API_KEY=ls__your-langsmith-api-key-here

# 啟用 LangSmith 追蹤
LANGCHAIN_TRACING_V2=true

# LangSmith 專案名稱（選用）
LANGCHAIN_PROJECT=langchain-demos

# LangSmith API Endpoint（通常不需要修改）
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==================== 搜尋工具 ====================

# Tavily API Key (建議，用於網路搜尋)
# 獲取方式: https://tavily.com/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Google Search API (選用)
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-custom-search-engine-id

# ==================== 向量資料庫 ====================

# Pinecone API Key (選用，用於雲端向量資料庫)
# 獲取方式: https://www.pinecone.io/
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_ENVIRONMENT=your-pinecone-environment

# Weaviate (選用)
# WEAVIATE_URL=your-weaviate-url
# WEAVIATE_API_KEY=your-weaviate-api-key

# ==================== 其他服務 ====================

# GitHub Token (選用，用於程式碼分析)
# GITHUB_TOKEN=ghp_your-github-token-here

# Notion Integration Token (選用)
# NOTION_INTEGRATION_TOKEN=secret_your-notion-token

# Slack Bot Token (選用)
# SLACK_BOT_TOKEN=xoxb-your-slack-token

# ==================== 應用設定 ====================

# 模型設定
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.0

# 向量資料庫設定
VECTOR_DB_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 快取設定
ENABLE_CACHE=true
CACHE_DIR=./.cache

# ==================== 安全性設定 ====================

# API Rate Limiting
MAX_REQUESTS_PER_MINUTE=60

# Token Limits
MAX_TOKENS_PER_REQUEST=4000

# ==================== 開發設定 ====================

# 除錯模式
DEBUG=false

# 開發環境
ENVIRONMENT=development

# ==================== 注意事項 ====================
#
# 1. 請勿將包含真實 API Key 的 .env 文件提交到 Git
# 2. 定期更換 API Keys 以確保安全
# 3. 使用最小權限原則配置 API Keys
# 4. 在生產環境中使用環境變數或密鑰管理服務
# 5. 監控 API 使用量以避免超出配額
#
# ===========================================
