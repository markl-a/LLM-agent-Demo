# LLM API 配置
# 選擇一個即可，推薦 OpenAI 或 Google

# OpenAI (推薦)
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1

# Google Gemini (免費額度)
# GOOGLE_API_KEY=AIza...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# 向量數據庫配置
CHROMA_PERSIST_DIRECTORY=./vectorstore

# 應用配置
LOG_LEVEL=INFO
DEBUG=False
