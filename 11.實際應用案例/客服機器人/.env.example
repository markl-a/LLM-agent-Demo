# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_environment

# 可選：其他服務
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://user:pass@localhost/dbname
