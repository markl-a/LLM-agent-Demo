# EditorConfig 配置文件
# 幫助開發者在不同的編輯器和 IDE 之間保持一致的編碼風格
# 更多信息: https://editorconfig.org

# 這是最頂層的 EditorConfig 文件
root = true

# 所有文件的通用設置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python 文件
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Jupyter Notebooks
[*.ipynb]
indent_style = space
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# TOML 文件
[*.toml]
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 100

# reStructuredText 文件
[*.rst]
indent_style = space
indent_size = 3
max_line_length = 100

# Shell 腳本
[*.sh]
indent_style = space
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 2

# Docker Compose
[docker-compose*.yml]
indent_style = space
indent_size = 2

# Makefile (必須使用 tab)
[Makefile]
indent_style = tab
indent_size = 4

# HTML/CSS/JavaScript
[*.{html,css,js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# XML
[*.xml]
indent_style = space
indent_size = 2

# 配置文件
[*.{ini,cfg,conf}]
indent_style = space
indent_size = 4

# Git 配置
[.gitconfig]
indent_style = tab

# 忽略自動生成的文件
[{package-lock.json,*.min.js,*.min.css}]
insert_final_newline = false
trim_trailing_whitespace = false
